# Letakkan salah satu API Key Anda di bawah ini untuk mengaktifkan AI Copilot Generatif:

# 1. Google Gemini API (Direkomendasikan - Cepat & Kuat)
# Dapatkan gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. OpenAI API (Opsional)
# Dapatkan di: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 3. Groq Cloud API (Opsional - Ultra Fast)
# Dapatkan gratis di: https://console.groq.com/keys
GROQ_API_KEY=

# 4. Local Ollama (Opsional jika menjalankan LLM lokal di laptop)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
