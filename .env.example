# ==============================================================================
# Nashta Annual Report RAG - Generative AI Configuration
# ==============================================================================
# Letakkan API Key Anda di bawah ini untuk mengaktifkan AI Copilot Generatif:

# 1. Mistral AI / Ministral API Key (Ministral 8B / Mistral Small / Large)
# Dapatkan di: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest
# Pilihan model lain: ministral-3b-latest, mistral-small-latest, mistral-large-latest

# 2. Google Gemini API (Opsional)
# Dapatkan di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. OpenAI API (Opsional)
# Dapatkan di: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 4. Groq Cloud API (Opsional - Ultra Fast)
# Dapatkan di: https://console.groq.com/keys
GROQ_API_KEY=

# 5. Local Ollama (Opsional jika menjalankan LLM lokal di laptop)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
